{
  "manifest_version": 3,
  "name": "AskChatty",
  "version": "1.0.0",
  "description": "Highlight text on any page and ask Claude focused follow-ups in a floating side-chat.",
  "permissions": ["storage", "contextMenus", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "AskChatty settings & history",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "web_accessible_resources": [{ "resources": ["icons/icon32.png"], "matches": ["<all_urls>"] }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "ask-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Ask Claude about the selected text"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
